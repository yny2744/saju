{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@tenant-active": ["./src/tenants/ryugyeol.ts"]
    }
  },
  "include": ["src/server/**/*.ts", "tests/**/*.ts"]
}
