# Phase 4 웹 서비스 실행에 필요한 환경변수 예시 파일.
# 실제 값은 절대 이 파일이나 소스코드에 하드코딩하지 않는다 (지시서 8조).
# 배포 환경(Vercel 등)의 "Environment Variables" 설정에 실제 값을 등록해서 사용한다.

# Anthropic API Key. 서버(Node.js 런타임)에서만 사용되며, 클라이언트에는 절대 전달되지 않는다.
# 접두어를 NEXT_PUBLIC_로 붙이지 않는다 - 붙이면 브라우저 번들에 그대로 노출된다.
ANTHROPIC_API_KEY=

# Gemini API Key (선택). ANTHROPIC_API_KEY가 없을 때만 사용되는 두 번째 Provider 옵션.
# Google AI Studio(https://aistudio.google.com)에서 무료로 발급 가능하며, 무료 티어는
# 입력 데이터가 Google 제품 개선에 활용될 수 있다는 점을 감안한다.
# 마찬가지로 서버 전용이며 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
GEMINI_API_KEY=
# 생략 시 기본값(gemini-2.5-flash-lite) 사용.
SAJU_GEMINI_MODEL=

# 결과 조회 토큰(암호화)에 사용하는 서버 전용 비밀값. 32바이트 이상 무작위 문자열을 권장한다.
# 예: openssl rand -base64 32
# 설정하지 않으면 로컬 개발 환경에서는 경고와 함께 임시 기본값으로 동작하지만,
# 운영 환경(NODE_ENV=production)에서는 반드시 설정해야 하며 없으면 서버가 명시적으로 실패한다.
RESULT_TOKEN_SECRET=

# Production build + start 환경에서 실제 AI 연결 없이 사용자 흐름을 테스트할 때만 사용.
# 정확히 문자열 "true"일 때만 DevFallbackProvider를 허용하며, 그 외 값(false/1/yes 등)이나
# 미설정 상태에서는 기존과 동일하게 ANTHROPIC_API_KEY 누락 시 에러가 발생한다.
# 실제 운영 배포 환경에서는 반드시 설정하지 않는다(또는 false로 둔다).
ALLOW_MOCK_IN_PRODUCTION=false

# --- Phase 5: 상품/결제 ---

# Toss Payments 시크릿 키. 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 (서버 전용).
# 없으면 로컬 개발은 MockPaymentProvider로 자동 대체되고, 운영 환경(NODE_ENV=production)에서는
# 서버가 명시적으로 에러를 던진다 (조용히 가짜 결제 성공을 만들지 않는다).
PAYMENT_SECRET_KEY=

# 주문/결제상태/구매권한(entitlement) 토큰 암호화에 사용하는 서버 전용 비밀값.
# RESULT_TOKEN_SECRET과 별도 값을 권장한다.
PAYMENT_TOKEN_SECRET=

# Toss Payments 클라이언트(퍼블리셔블) 키. 브라우저에 노출되는 것이 Toss의 정상 설계라
# NEXT_PUBLIC_ 접두사가 필요하다 - PAYMENT_SECRET_KEY와 절대 혼동하지 않는다.
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# --- Phase 9: 관상(얼굴 특징) 서비스 ---

# 관상 무료 결과 저장 토큰 암호화에 사용하는 서버 전용 비밀값.
# RESULT_TOKEN_SECRET/PAYMENT_TOKEN_SECRET과 별도 값을 권장한다 (한 비밀값 회전이
# 다른 도메인 데이터를 연쇄적으로 무효화하지 않도록 분리).
# 설정하지 않으면 로컬 개발은 임시 기본값으로 동작하고, 운영 환경에서는 서버가 명시적으로 실패한다.
FACE_RESULT_TOKEN_SECRET=

# ANTHROPIC_API_KEY/GEMINI_API_KEY를 그대로 재사용하므로 관상 서비스 전용 API Key는
# 별도로 필요 없다 (지시서 3조).

# --- Phase 10.5: 로그인(회원) ---

# 이 프로젝트 최초의 영속 저장소. neon.tech 등에서 발급받는 Postgres 연결 문자열.
# 설정 안 하면 로그인 관련 API(/api/auth/*)가 명확한 에러를 반환한다 - 그 외
# 기존 기능(무료/유료 사주, 관상, 결제)은 이 값 없이도 그대로 동작한다.
DATABASE_URL=

# 카카오 개발자센터(developers.kakao.com)에서 앱 등록 후 발급받는 값.
# Redirect URI는 반드시 "<사이트주소>/api/auth/kakao/callback"로 등록해야 한다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
